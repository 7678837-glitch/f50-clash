# f50mgr secrets 模板
#
# 设备上的真实路径：/data/adb/f50mgr/config/secrets.toml（chmod 600）
# 模块安装时 customize.sh 会自动生成同结构的空模板；此文件仅供阅读参考，
# 不要把填了真实值的副本提交进版本库（**/secrets.toml 已被 .gitignore 忽略）。

[subscription]
# Clash 订阅地址。推荐通过面板 http://192.168.0.1:14180 导入（会自动写入此处）
url = ""

# 可选公司 Mihomo 更新源。普通配置中的 [download].company_base_url 启用后，
# daemon 才读取这里的 Basic Auth；真实凭据只保存在设备的 0600 文件中。
# [download]
# username = "your-username"
# password = "your-password"

# EasyTier mesh VPN（可选）。填入下列字段并把 f50mgr.toml 的
# [easytier].enabled 设为 true 后生效
# [easytier]
# network_name = "your-network"
# network_secret = "your-secret"
# ipv4 = "10.0.5.3"            # 每台 F50 唯一静态 IP
# # instance_id = "..."        # 需稳定身份时填写；留空则每次渲染生成 UUID
# # hostname = "F50-custom"    # 留空则用 "F50-{IMEI}"
# peers = [
#   "tcp://relay.example.com:11010/",
#   "udp://relay.example.com:11010/",
# ]
